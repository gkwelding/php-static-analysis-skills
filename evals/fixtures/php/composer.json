{
    "name": "eval/shop",
    "description": "Eval fixture: a small shop library with seeded PHPStan errors.",
    "type": "project",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {"Shop\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"Shop\\Tests\\": "tests/"}
    },
    "config": {"sort-packages": true}
}
